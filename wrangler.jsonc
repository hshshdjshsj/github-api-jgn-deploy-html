{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dirac",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "containers": [
    {
      "class_name": "DiracBackendContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 16,
      "ssh": {
        "enabled": false
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DIRAC_BACKEND",
        "class_name": "DiracBackendContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DiracBackendContainer"
      ]
    }
  ]
}
